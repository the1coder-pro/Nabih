{
  "manifest_version": 3,
  "name": "نبيه | Nabih",
  "version": "1.0.0",
  "description": "نبيه ينبهك - تنبيهات توعوية ذكية باللغة العربية عند فتح نماذج التسجيل وإدخال البيانات الحساسة",
  "icons": {
    "16": "Lock.png",
    "32": "Lock.png",
    "48": "Lock.png",
    "128": "Lock.png"
  },
  "host_permissions": ["https://api.mail.tm/*"],
  "background": { "service_worker": "tempMail.js" },
  "action": {
    "default_icon": {
      "16": "Lock.png",
      "32": "Lock.png",
      "48": "Lock.png",
      "128": "Lock.png"
    },
    "default_popup": "popup.html",
    "default_title": "نبيه | حارس الوعي والبيانات"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Lock.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
