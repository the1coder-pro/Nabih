{
  "manifest_version": 3,
  "name": "نبيه | Nabih",
  "version": "1.0.1",
  "description": "إضافة للمتصفح تقوم برفع وعي المستخدم حول أهمية بياناته الشخصية عن طريق عرض بعض التنبيهات الإرشادية أثناء قيامه بالتسجيل في المنصات و المواقع الرقمية",
  "icons": {
    "16": "Lock.png",
    "32": "Lock.png",
    "48": "Lock.png",
    "128": "Lock.png"
  },
  "background": { "service_worker": "tempMail.js" },
  "action": {
    "default_icon": {
      "16": "Lock.png",
      "32": "Lock.png",
      "48": "Lock.png",
      "128": "Lock.png"
    },
    "default_popup": "popup.html",
    "default_title": "نبيه | حارس الوعي والبيانات"
  },
  "permissions": ["tabs", "storage"],

  "host_permissions": [
    "https://api.mail.tm/*",
    "https://www.virustotal.com/*"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["mailRender.js", "content.js"],
      "css": ["style.css", "mail-view.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Lock.png", "sidebar.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
