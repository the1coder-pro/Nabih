{
  "manifest_version": 3,
  "name": "نبيه | Nabih",
  "version": "1.0.1",
  "description": "إضافة للمتصفح تقوم برفع وعي المستخدم حول أهمية بيانته الشخصية عن طريق عرض بعض التنبيهات الإرشادية أثناء قيامه بالتسجيل في المنصات و المواقع الرقمية",
  "icons": {
    "16": "Lock.png",
    "32": "Lock.png",
    "48": "Lock.png",
    "128": "128_Lock.png"
  },
  "background": {
    "service_worker": "tempMail.js"
  },
  "action": {
    "default_icon": {
      "16": "Lock.png",
      "32": "Lock.png",
      "48": "Lock.png",
      "128": "128_Lock.png"
    },
    "default_popup": "popup.html",
    "default_title": "نبيه | حارس الوعي والبيانات"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.mail.tm/*",
    "https://www.virustotal.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Lock.png", "128_Lock.png", "sidebar.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.0"
    }
  }
}
