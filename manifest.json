{
  "name": "Nabih",
  "description": "Nabih ynabhik",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
     "16": "Lock.png",
      "32": "Lock.png",
      "48": "Lock.png",
      "128": "Lock.png"
    
  },
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
   "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+B",
        "mac": "Command+B"
      }
    }},
    "content_scripts": [
    {
      "js": ["content.js"],
      "run_at": "document_idle",
      "matches": [
      "<all_urls>"
      ]
    }
  ]
}